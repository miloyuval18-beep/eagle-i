# Copy this file to .env and fill in real values. Never commit the real .env file.

# Required — the app will not run without these.
DATABASE_URL=postgres://user:password@host:5432/eagle_i
SESSION_SECRET=some-long-random-string

# Required for AI generation (onboarding, Strategy/Keywords/Competitors/Opportunities,
# ad copy, PR drafts, etc.) — routes fall back to a clean "not configured" error without it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Everything below is optional — each feature is gated behind its own vars and returns a
# clean 503 "not configured yet" until they're supplied. See README.md for what each does.

# Encrypts stored OAuth access/refresh tokens (Meta, Google Business Profile, Google Ads).
# Must be a 64-character hex string (32 bytes) — generate with: openssl rand -hex 32
SOCIAL_CREDENTIALS_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Real Facebook/Instagram posting + Meta Ads (routes/social.js, routes/ads.js)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_ADS_REDIRECT_URI=

# Real Google Ads campaign creation (routes/ads.js)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=

# Real Google Business Profile posting (routes/gbp.js)
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=

# Real nearby-competitor/vendor lookups via Places API (New) (lib/googlePlaces.js)
GOOGLE_PLACES_API_KEY=

# Review-request emails (lib/email.js)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Crash-alert emails (lib/alerting.js) — where uncaught errors get emailed
ADMIN_ALERT_EMAIL=
